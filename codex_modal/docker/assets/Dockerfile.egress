# Egress broker for codex-modal --docker. This container is the only member of
# the sandbox network with a route off it, and it holds the upstream credential
# that the sandbox is deliberately not given.
FROM python:3.12-alpine

RUN adduser -D -u 10002 egress
COPY egress_proxy.py /opt/egress_proxy.py
RUN chmod 0444 /opt/egress_proxy.py

USER egress
ENV PYTHONUNBUFFERED=1
EXPOSE 3128 8081
ENTRYPOINT ["python3", "/opt/egress_proxy.py"]
