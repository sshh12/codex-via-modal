# Sandbox image for codex-modal --docker. A general dev/cyber box: Codex runs
# here with approvals and its own sandbox disabled, and the container is the
# security boundary. Kept broad on purpose so the agent rarely has to install
# tooling mid-task; extra apt packages can still be added with --docker-packages.
FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.147.0
ARG EXTRA_PACKAGES=""
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

# Core runtime, build toolchains, language stacks, and cyber/network tooling.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl wget gnupg lsb-release apt-transport-https \
        git git-lfs openssh-client rsync unzip zip xz-utils zstd \
        gosu sudo tini locales tzdata \
        iproute2 iptables dnsutils iputils-ping netcat-openbsd socat \
        nmap tcpdump whois net-tools \
        build-essential pkg-config make cmake automake autoconf gdb \
        clang lld llvm binutils file patch \
        python3 python3-pip python3-venv python3-dev python-is-python3 pipx \
        golang \
        default-jdk-headless \
        ripgrep fd-find fzf jq yq bat tree less vim nano tmux \
        htop procps psmisc lsof strace ltrace \
        sqlite3 postgresql-client default-mysql-client redis-tools \
        imagemagick ffmpeg poppler-utils \
        bind9-host telnet man-db bash-completion; \
    rm -rf /var/lib/apt/lists/*

RUN sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# Headless Chromium plus the shared libraries a real browser needs, so the agent
# can drive it via Playwright/Puppeteer/CDP. Debian ships chromium on both amd64
# and arm64, which keeps this portable across machines.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        chromium chromium-driver fonts-liberation fonts-noto-color-emoji \
        libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
        libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
        libgbm1 libpango-1.0-0 libcairo2 libasound2 libatspi2.0-0; \
    rm -rf /var/lib/apt/lists/*
ENV CHROME_BIN=/usr/bin/chromium \
    CHROMIUM_FLAGS="--no-sandbox --headless=new --disable-gpu --disable-dev-shm-usage"

# Rust via rustup into a shared location so the agent user can use and extend it.
ENV RUSTUP_HOME=/opt/rust CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:/usr/local/go/bin:$PATH
RUN set -eux; \
    curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal; \
    chmod -R a+rwX /opt/rust /opt/cargo; \
    rustc --version

# Python and Node tooling commonly reached for in dev and security work. uv is
# the fast installer; the pip set covers web, browser automation, and recon.
RUN set -eux; \
    pipx install uv --global 2>/dev/null || pip3 install --no-cache-dir --break-system-packages uv; \
    pip3 install --no-cache-dir --break-system-packages \
        requests httpx rich pyyaml beautifulsoup4 lxml \
        playwright pwntools; \
    python3 -m playwright install-deps chromium 2>/dev/null || true; \
    npm install -g --force "@openai/codex@${CODEX_VERSION}" pnpm typescript ts-node puppeteer-core; \
    npm cache clean --force; \
    codex --version

# Point Playwright/Puppeteer at the system Chromium rather than downloading one
# (the sandbox has no route to their CDNs at runtime anyway).
ENV PLAYWRIGHT_BROWSERS_PATH=0 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# This is a throwaway devbox: let `pip install` work without a venv and without
# the per-command --break-system-packages dance (PEP 668).
ENV PIP_BREAK_SYSTEM_PACKAGES=1 PIP_ROOT_USER_ACTION=ignore
RUN rm -f /usr/lib/python3*/EXTERNALLY-MANAGED

RUN set -eux; \
    apt-get update; \
    if [ -n "${EXTRA_PACKAGES}" ]; then \
        apt-get install -y --no-install-recommends ${EXTRA_PACKAGES}; \
    fi; \
    rm -rf /var/lib/apt/lists/*

# uid/gid 10001 avoids colliding with the base image's `node` user and with any
# uid the host happens to use.
RUN set -eux; \
    groupadd --gid 10001 agent; \
    useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash agent; \
    mkdir -p /sandbox /work /sandbox-state; \
    chown agent:agent /work /sandbox-state; \
    chmod 0755 /sandbox; \
    # Yolo mode: the agent may install arbitrary system packages. The container
    # is the boundary, so passwordless root inside it is intended.
    printf '%s\n' \
        'agent ALL=(ALL) NOPASSWD:ALL' \
        'Defaults env_keep += "http_proxy https_proxy ftp_proxy no_proxy"' \
        'Defaults env_keep += "HTTP_PROXY HTTPS_PROXY FTP_PROXY NO_PROXY ALL_PROXY"' \
        > /etc/sudoers.d/agent; \
    chmod 0440 /etc/sudoers.d/agent

ENV HOME=/home/agent \
    CODEX_MODAL_STATE_ROOT=/sandbox-state \
    PYTHONPATH=/sandbox \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_PREFIX=/home/agent/.npm-global \
    GOPATH=/home/agent/go \
    GOFLAGS=-buildvcs=false \
    PATH=/home/agent/.local/bin:/home/agent/.npm-global/bin:/home/agent/go/bin:/opt/cargo/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Codex runs commands through `bash -lc`; a login shell resets PATH from
# /etc/profile and would drop the additions above. Re-add them for login shells
# so user-installed CLIs (pip --user, npm -g) and the language toolchains resolve.
RUN printf '%s\n' \
    'export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/go/bin:/opt/cargo/bin:/usr/local/go/bin:$PATH"' \
    > /etc/profile.d/10-devbox-path.sh; \
    chmod 0644 /etc/profile.d/10-devbox-path.sh

WORKDIR /work
ENTRYPOINT ["/bin/sh", "/sandbox/agent-init.sh"]
